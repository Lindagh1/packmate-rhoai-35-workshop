FROM registry.access.redhat.com/ubi9/python-312:latest

WORKDIR /app

USER root

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY evals/ ./evals/

# OpenShift: support arbitrary UID with group 0 (no root at runtime).
RUN chgrp -R 0 /app && \
    chmod -R g=u /app && \
    chmod -R g+rwX /tmp

EXPOSE 8080

USER 1001

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
